  "findings": [
    {
      "id": "F01",
      "severity": "informational",
      "title": "Identical replay accepted for the saved revision and one revision behind",
      "detail": "replace_selection() treats data.revision in {revision, revision-1} as a replay when the state matches. A two-step-old identical replay returns 409. This is intentional idempotency, but clients must not interpret a 200 replay as a new revision.",
      "case": "H02"
    },
    {
      "id": "F02",
      "severity": "informational",
      "title": "Channel declarations are dropped when the reviewed channel is no longer active in the billing market",
      "detail": "entitlement_reads.EntitlementContext.evaluate rebuilds the Selection without its channel map when (host, billing_country, channel_id) is absent from the active reviewed channel set. A declared child therefore yields HOLDING_UNCONFIRMED rather than INCLUDED after catalogue retirement, which is the desired no-false-positive outcome but must be asserted explicitly.",
      "case": "H04"
    },
    {
      "id": "F03",
      "severity": "informational",
      "title": "Language mismatch is a false value, not null, in the shared fixture harness",
      "detail": "test_issue103_fixtures.run_case passes viewer.languageMatch directly as the language triple member. project_title checks `language is None` for missing language info; a false value takes the verified-anywhere branch and yields available_elsewhere. Harnesses must preserve that distinction or E41 will be mis-scored.",
      "case": "E41"
    },
    {
      "id": "F04",
      "severity": "needs-evidence",
      "title": "No real positive product mapping is enabled",
      "detail": "The backend verification audit states no reviewed source mappings or real-world rights assertions are shipped. Every real paid positive remains UNKNOWN until independently reviewed first-party title/plan/market evidence is supplied. No live call was made to test this.",
      "case": "E38"
    }
  ]
}
