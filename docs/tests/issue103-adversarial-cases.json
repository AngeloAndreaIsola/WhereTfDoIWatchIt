        {"body": {"holding": "no", "plan_state": "selected", "plan_id": "base", "channels": [], "revision": 0}, "why": "selected plan without held base"},
        {"body": {"holding": "yes", "plan_state": "unsupported", "plan_id": "base", "channels": [], "revision": 0}, "why": "non-null plan id with unsupported state"},
        {"body": {"holding": "yes", "plan_state": "selected", "plan_id": "paid-ads", "channels": [], "revision": 0}, "why": "plan belongs to DE, not NL"},
        {"body": {"holding": "yes", "plan_state": "selected", "plan_id": "Base", "channels": [], "revision": 0}, "why": "case-variant of a plan id"},
