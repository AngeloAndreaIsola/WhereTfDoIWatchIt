  "httpCases": [
    {
      "id": "H01-catalogue-market-scoping",
      "group": "base-vs-premium",
      "seed": {
        "provider": {"slug": "synthetic-aster", "name": "Aster"},
        "countries": ["NL", "DE"],
        "plans": [
          {"plan_id": "base", "billing_country": "NL", "plan_class": "base", "caveat": ""},
          {"plan_id": "premium", "billing_country": "NL", "plan_class": "premium", "caveat": ""},
          {"plan_id": "paid-ads", "billing_country": "DE", "plan_class": "paid_ads", "caveat": "Ad-supported"}
        ],
        "channels": [
          {"package_id": "orbit", "parent_provider": "synthetic-aster", "country": "NL", "caveat": ""},
          {"package_id": "comet", "parent_provider": "synthetic-aster", "country": "NL", "caveat": ""},
          {"package_id": "foreign", "parent_provider": "synthetic-aster", "country": "DE", "caveat": ""}
        ],
        "legacySubscription": {"provider": "synthetic-aster", "name": "Aster"}
      },
      "request": {"method": "GET", "path": "/api/providers/?billing_country=NL"},
      "expect": {
        "status": 200,
        "providerRow": {
          "slug": "synthetic-aster",
          "plan_options": [
            {"plan_id": "base", "display_name": "base", "class": "base", "billing_country": "NL", "caveat": ""},
            {"plan_id": "premium", "display_name": "premium", "class": "premium", "billing_country": "NL", "caveat": ""}
          ],
          "channel_options": [
            {"package_id": "comet", "parent_provider": "synthetic-aster", "country": "NL", "caveat": ""},
            {"package_id": "orbit", "parent_provider": "synthetic-aster", "country": "NL", "caveat": ""}
          ],
          "unlisted_plan_option": {"plan_id": null, "plan_state": "unsupported", "display_name": "I don't know / my plan isn't listed"},
          "selection": {"holding": "yes", "plan_state": "unspecified", "plan_id": null, "plan_display_name": null, "channels": [], "revision": 0}
        },
        "assertions": [
          "DE plan 'paid-ads' and DE channel 'foreign' are absent from the NL catalogue",
          "legacy subscription seeds only a coarse holding yes with plan_state unspecified",
          "unlisted option has null plan_id and is distinct from an unknown arbitrary plan id",
          "GET /api/providers/?billing_country=XYZ returns 400"
        ]
      }
    },
    {
      "id": "H02-first-write-and-refresh-persistence",
      "group": "browser-refresh-persisted-selection-recovery",
      "seed": {"provider": "synthetic-aster", "billing_country": "NL"},
      "steps": [
        {
          "request": {
            "method": "PUT",
            "path": "/api/subscriptions/synthetic-aster/markets/NL/",
            "body": {"holding": "yes", "plan_state": "selected", "plan_id": "base", "channels": [{"package_id": "orbit", "holding": "yes"}, {"package_id": "comet", "holding": "no"}], "revision": 0}
          },
          "expect": {
            "status": 200,
            "body": {"holding": "yes", "plan_state": "selected", "plan_id": "base", "plan_display_name": "base", "channels": [{"package_id": "comet", "holding": "no"}, {"package_id": "orbit", "holding": "yes"}], "revision": 1}
          }
        },
        {
          "request": {"method": "GET", "path": "/api/providers/?billing_country=NL"},
          "expect": {
            "status": 200,
            "assertions": [
              "selection.revision === 1 after a simulated browser refresh",
              "selection.plan_id === 'base' and plan_display_name === 'base'",
              "both channel declarations are returned sorted by package_id"
            ]
          }
        },
        {
          "request": {
            "method": "PUT",
            "path": "/api/subscriptions/synthetic-aster/markets/NL/",
            "body": {"holding": "yes", "plan_state": "selected", "plan_id": "premium", "channels": [], "revision": 0}
          },
          "expect": {
            "status": 409,
            "body": {"code": "revision_conflict", "selection": {"holding": "yes", "plan_state": "selected", "plan_id": "base", "plan_display_name": "base", "channels": [{"package_id": "comet", "holding": "no"}, {"package_id": "orbit", "holding": "yes"}], "revision": 1}},
            "assertions": ["client must reload the saved selection and keep its draft visible"]
          }
        },
        {
          "request": {
            "method": "PUT",
            "path": "/api/subscriptions/synthetic-aster/markets/NL/",
            "body": {"holding": "yes", "plan_state": "selected", "plan_id": "base", "channels": [{"package_id": "comet", "holding": "no"}, {"package_id": "orbit", "holding": "yes"}], "revision": 0}
          },
          "expect": {"status": 200, "assertions": ["identical replay returns the saved revision 1 without incrementing"]}
        },
        {
          "request": {
            "method": "PUT",
            "path": "/api/subscriptions/synthetic-aster/markets/NL/",
            "body": {"holding": "yes", "plan_state": "selected", "plan_id": "base", "channels": [], "revision": 0}
          },
          "expect": {"status": 409, "assertions": ["a two-step-old replay is outside the accepted {revision, revision-1} window"]}
        }
      ]
    },
