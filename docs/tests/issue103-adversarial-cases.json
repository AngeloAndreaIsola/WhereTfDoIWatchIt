    "startsAt": null,
    "endsAt": null,
    "ruleObservedAt": "2030-01-14T12:00:00Z",
    "ruleFreshUntil": "2030-01-17T12:00:00Z",
    "ruleStartsAt": "2030-01-14T12:00:00Z"
  },
  "extendedFields": {
    "sourceSupported": "sets OfferFact.source_supported; false models a source/package mapping not enabled for review -> SOURCE_UNSUPPORTED",
    "publicConditionsMet": "sets OfferFact.public_conditions_met for free/free_with_ads only -> PUBLIC_CONDITIONS_UNCONFIRMED when false",
    "conflicted": "sets OfferFact.conflicted -> EVIDENCE_CONFLICT",
    "observedAt": "overrides OfferFact.observed_at; a value after asOf -> EVIDENCE_UNVERIFIED",
    "startsAt/endsAt": "override OfferFact window bounds; asOf outside [startsAt,endsAt) -> STALE_EVIDENCE",
    "ruleObservedAt/ruleFreshUntil/ruleStartsAt": "override CoverageRule freshness/validity; asOf outside the rule window -> NO_APPLICABLE_RULE",
    "portability='conflicting'": "emits two otherwise identical rules with portability allowed and denied -> EVIDENCE_CONFLICT",
    "noSelection": "passes selection=None into the evaluator -> HOLDING_UNCONFIRMED; models a missing/legacy-only profile on a paid offer"
  },
