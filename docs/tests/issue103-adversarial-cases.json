    "asOf": "2030-01-15T12:00:00Z",
    "titleId": 900001,
    "observedAt": "2030-01-14T12:00:00Z",
    "ruleWindow": "[observedAt, ruleUntil) with startsAt=observedAt",
    "factWindow": "[startsAt, endsAt); null bounds mean unbounded",
    "mergeRule": "merge each case.viewer over viewerDefaults and each offer over offerDefaults independently, retaining explicit nulls; all rows share titleId",
    "scopeEncoding": "scope=season:N uses content_type=series and season=N; scope=series uses content_type=series and season=null; scope=movie uses content_type=movie",
    "planStateMapping": "viewerPlan null -> unspecified; 'unmapped' -> unsupported; any other string -> selected",
    "channelMapping": "selection.channels = {'orbit_via_aster': viewer.channel}; no other key is populated",
    "localityMapping": "market == viewer.current -> local; market in viewer.vpn -> vpn; market null -> unknown; otherwise -> out_of_reach",
    "languageMapping": "viewer.languageMatch true -> true; false -> false (NOT null); null -> null",
    "titleProjection": "project_title() over (entitlement, locality, language) triples, evaluated after the per-row gate; row order must not change keyed results or the title state"
  },
  "viewerDefaults": {
    "provider": "aster",
    "holding": "yes",
    "plan": "base",
    "channel": "unspecified",
    "billing": "NL",
    "current": "NL",
    "vpn": [],
