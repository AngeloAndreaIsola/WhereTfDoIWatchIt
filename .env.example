# Postgres — shared by the db service and Django
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker_dev
POSTGRES_DB=tracker
# Host/port as seen from the backend container; override for bare-metal dev.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# External API keys
TMDB_API_KEY=your_tmdb_api_key_here
RAPIDAPI_KEY=your_rapidapi_key_here

# Backend URL as seen from the frontend container (internal, SSR fetch only)
BACKEND_URL=http://backend:8000
