# Postgres — shared by the db service and Django
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker_dev
POSTGRES_DB=tracker
# Host/port as seen from the backend container; override for bare-metal dev.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# External API keys
# TMDB_API_KEY accepts EITHER a classic v3 API key (32-char hex) or a v4 "API
# Read Access Token" (a long JWT starting with eyJ). The client detects which
# you pasted and authenticates accordingly.
TMDB_API_KEY=your_tmdb_api_key_here
RAPIDAPI_KEY=your_rapidapi_key_here

# Prime MVP behavior (optional — sensible defaults live in settings.py)
# When true, a cache miss on /api/prime/movie/<id>/ triggers ONE live Streaming
# Availability fetch, honoring the 100/day cap. Set false to serve cached rows only.
PRIME_LIVE_FETCH=true
# Stable Streaming Availability service id the Prime endpoints filter on
# (the API id, e.g. "prime" for Prime Video — not the display name).
DEFAULT_PREFERENCE_PROVIDER=prime

# Backend URL as seen from the frontend container (internal, SSR fetch only)
BACKEND_URL=http://backend:8000
